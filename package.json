{
  "name": "odm-cmms",
  "version": "2.0.0",
  "description": "Operator-Driven Maintenance Computerized Maintenance Management System",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "db:init": "node src/utils/init-db.js",
    "db:init-simple": "node src/utils/init-db-simple.js",
    "db:migrate:postgres": "node scripts/migrate-postgres.js",
    "db:migrate:multitenant": "node database/migrations/run-multitenant-migration.js",
    "import:csv": "node src/utils/import-csv.js",
    "import:smp": "node src/utils/import-smp.js",
    "import:smps": "node src/utils/batch-import-smps.js",
    "reset:all": "reset-and-rebuild.bat",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:all": "node scripts/run-all-tests.js",
    "diagnose:coverage": "node scripts/diagnostics/coverage-api.js",
    "diagnose:gaps": "node scripts/diagnostics/gap-api.js"
  },
  "keywords": [
    "cmms",
    "maintenance",
    "management",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "pdfkit": "^0.14.0",
    "qrcode": "^1.5.4",
    "stripe": "^14.25.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scriptsComments": {
    "start": "Production server",
    "dev": "Development with auto-reload"
  }
}
