+
+/** Internal columns deliberately NOT served by a user profile. */
+const WITHHELD_INTERNAL_FIELDS = [
+  'invited_by', 'invited_at', 'is_billable',
+  'is_sso_user', 'sso_provider', 'last_sso_login_at'
