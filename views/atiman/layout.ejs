<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <%# Pinch zoom is deliberately NOT disabled: user-scalable=no is architectural
      debt per ATM-002-R1 §2 H / R7 §4 and must not appear in the new shell. %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1f2933">
  <title><%= title %> · Atiman</title>
  <link rel="stylesheet" href="/css/atiman-tokens.css">
  <link rel="stylesheet" href="/css/atiman-shell.css">
  <link rel="manifest" href="/manifest.json">
</head>
<body class="atiman" data-connectivity="online">
  <a class="atiman-skip-link" href="#atiman-main">Skip to main content</a>
  <div class="atiman-layout">
    <%- include('partials/header', { title: title, organizationName: organizationName, accountHref: accountHref }) %>
    <%- include('partials/nav', { workNavigation: workNavigation, activeDestination: activeDestination }) %>
    <main class="atiman-main" id="atiman-main" tabindex="-1">
      <%- body %>
    </main>
  </div>
  <script src="/js/capabilities.js"></script>
  <script src="/js/atiman-shell.js"></script>
</body>
</html>
